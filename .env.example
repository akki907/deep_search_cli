# Template for react_loop. Copy to .env and fill in your keys:
#   cp .env.example .env

# Provider: openai | openrouter | together | groq | ollama | anthropic | scripted
LLM_PROVIDER=ollama

# Model id passed to the provider.
REACT_MODEL=llama3.1

# Key for the provider above. Only the one you use is needed.
OPENROUTER_API_KEY=

# Uncomment only if you use these providers instead.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=

